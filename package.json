{
  "name": "@dukeofwest/universal-file-preview",
  "version": "0.1.1",
  "description": "Browser-based TypeScript previews for images and selected DOCX, XLSX, and PPTX content.",
  "keywords": [
    "file-preview",
    "document-viewer",
    "file-viewer",
    "document-preview",
    "docx",
    "docx-preview",
    "xlsx",
    "xlsx-viewer",
    "pptx",
    "pptx-viewer",
    "office-open-xml",
    "ooxml",
    "typescript",
    "javascript",
    "image-preview",
    "image-viewer",
    "office-documents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dukeofwest/universal-file-preview.git"
  },
  "homepage": "https://github.com/dukeofwest/universal-file-preview#readme",
  "bugs": {
    "url": "https://github.com/dukeofwest/universal-file-preview/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "tsc -p tsconfig.json",
    "demo": "node apps/demo/server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
