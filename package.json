{
  "name": "@dukeofwest/universal-file-preview",
  "version": "0.2.2",
  "description": "Zero-dependency browser previews for DOCX, XLSX, PPTX, ODS and images, in TypeScript. Optional Web Worker parsing, strict Content Security Policy and Trusted Types support.",
  "keywords": [
    "file-preview",
    "document-viewer",
    "file-viewer",
    "document-preview",
    "docx",
    "docx-preview",
    "xlsx",
    "xlsx-viewer",
    "pptx",
    "pptx-viewer",
    "office-open-xml",
    "ooxml",
    "opendocument",
    "ods",
    "typescript",
    "javascript",
    "image-preview",
    "image-viewer",
    "office-documents",
    "word",
    "excel",
    "powerpoint",
    "word-viewer",
    "excel-viewer",
    "powerpoint-viewer",
    "docx-viewer",
    "xlsx-preview",
    "pptx-preview",
    "spreadsheet",
    "spreadsheet-viewer",
    "presentation-viewer",
    "office-viewer",
    "office-preview",
    "ods-viewer",
    "ots",
    "fods",
    "libreoffice",
    "openoffice",
    "attachment-preview",
    "attachment-viewer",
    "file-upload-preview",
    "upload-preview",
    "svg-viewer",
    "browser",
    "client-side",
    "framework-agnostic",
    "zero-dependencies",
    "no-dependencies",
    "web-worker",
    "csp",
    "content-security-policy",
    "trusted-types",
    "svg-sanitizer",
    "react",
    "vue",
    "angular"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dukeofwest/universal-file-preview.git"
  },
  "homepage": "https://github.com/dukeofwest/universal-file-preview#readme",
  "bugs": {
    "url": "https://github.com/dukeofwest/universal-file-preview/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/worker.js"
  ],
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs",
    "!docs/research",
    "!docs/security"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "tsc -p tsconfig.json",
    "build:pages": "npm run build --prefix examples/angular && npm run build --prefix examples/react && npm run build --prefix examples/vue && node scripts/assemble-pages.mjs",
    "preview:pages": "node apps/pages/server.mjs",
    "demo": "node apps/demo/server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:security": "npm run build && node --test --test-concurrency=1 tests/*.security.mjs",
    "test:performance": "npm run build && node --test --test-concurrency=1 tests/*.performance.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
